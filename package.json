{
  "name": "focusflow-app",
  "version": "0.0.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "cypress run",
    "e2e:open": "cypress open"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
